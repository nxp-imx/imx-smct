{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Schema for SoC configuration (sm_model/soc.json)",
  "definitions": {
    "model_reference": {
      "type": "string",
      "description": "Reference to a model JSON file",
      "pattern": "^[A-Za-z0-9_\\-]+\\.json$"
    },
    "component_identifier": {
      "type": "string",
      "description": "Component identifier",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "soc_config_base": {
      "type": "object",
      "properties": {
        "soc_model": {
          "$ref": "#/definitions/model_reference",
          "description": "SoC model file reference"
        },
        "sm_model": {
          "$ref": "#/definitions/model_reference",
          "description": "Security Monitor model file reference"
        }
      },
      "required": ["soc_model", "sm_model"],
      "additionalProperties": false
    },
    "soc_config_extended": {
      "type": "object",
      "properties": {
        "soc_model": {
          "$ref": "#/definitions/model_reference",
          "description": "SoC model file reference"
        },
        "sm_model": {
          "$ref": "#/definitions/model_reference",
          "description": "Security Monitor model file reference"
        },
        "sm_component": {
          "$ref": "#/definitions/component_identifier",
          "description": "Security Monitor component identifier"
        }
      },
      "required": ["soc_model", "sm_model", "sm_component"],
      "additionalProperties": false
    }
  },
  "properties": {
    "simu": {
      "$ref": "#/definitions/soc_config_base",
      "description": "Simulation configuration (required)"
    }
  },
  "patternProperties": {
    "^(?!simu$)[A-Za-z0-9_]+$": {
      "$ref": "#/definitions/soc_config_extended",
      "description": "Configuration for a specific SoC"
    }
  },
  "required": ["simu"],
  "additionalProperties": false
}